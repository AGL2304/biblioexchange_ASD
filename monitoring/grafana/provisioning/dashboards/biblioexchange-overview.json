{
  "title": "BiblioExchange — Vue d'ensemble",
  "uid": "biblioexchange-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API — statut (up/down)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"biblioexchange-api\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Taux d'erreurs 5xx (5m)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Charge CPU host (node-exporter)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Échanges créés (24h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "biblioexchange_exchanges_created_24h", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Échanges par statut",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "biblioexchange_exchanges_by_status", "legendFormat": "{{statut}}", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Signalements ouverts",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 15, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "biblioexchange_reports_open", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 3 }, { "color": "red", "value": 5 }
      ] } } }
    },
    {
      "id": 7,
      "title": "Livres en attente de modération",
      "type": "stat",
      "gridPos": { "h": 6, "w": 5, "x": 19, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "biblioexchange_books_pending_moderation", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 20 }
      ] } } }
    }
  ]
}